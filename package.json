{
  "name": "conxius-platform",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:lifecycle-control": "bash scripts/ci/run-lifecycle-control-gates.sh",
    "check:phase6:sequence1": "bash scripts/ci/run-cross-repo-harness-mvp.sh",
    "prepublishOnly": "node -e \"console.error('npm publish is disabled for now in this repository; use Git tags and GitHub Releases.'); process.exit(1)\""
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "8.0.5"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.18",
      "ip-address": ">=10.1.1",
      "postcss": ">=8.5.10",
      "langsmith": ">=0.5.19",
      "uuid": ">=13.0.1",
      "vite": "8.0.5"
    }
  }
}
