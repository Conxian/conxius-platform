{
  "name": "admin-dashboard",
  "version": "0.2.5",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:m2m": "vitest run src/tests/m2m.test.ts src/tests/m2mKeyRotation.test.ts",
    "test:phase7": "vitest run src/tests/phase7Alignment.test.ts src/tests/bitvmx.test.ts",
    "prepublishOnly": "node -e \"console.error('pnpm publish is disabled for now in this repository; use Git tags and GitHub Releases.'); process.exit(1)\""
  },
  "dependencies": {
    "imapflow": "^1.6.6",
    "jose": "^6.2.8",
    "mailparser": "^3.9.15",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "nostr-tools": "^2.24.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
