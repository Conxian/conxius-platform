# Conxian Monorepo Configuration Template

# Core API Endpoint (Gateway)
# Local development default: http://localhost:8080
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080

# Database URI (for Gateway Engine)
# Example: postgres://user:pass@localhost:5432/conxian
DATABASE_URL=

# Stacks L2 Network Settings
STACKS_NETWORK=testnet

# Nexus Glass Node State Tracking
NEXUS_SYNC_INTERVAL_MS=30000

# Institutional Settlement Flags
# Canonical flag: ISO 20022 PACS.008 (preferred)
ENABLE_ISO20022_PACS008=true

# Gateway Bitcoin tx lifecycle state machine (CON-716 / #741)
CONXIAN_BTC_TX_LIFECYCLE_ENABLED=false
CONXIAN_BTC_TX_LIFECYCLE_SHADOW_MODE=false
CONXIAN_BTC_TX_LIFECYCLE_ROLLOUT_MODE=shadow
CONXIAN_BTC_TX_LIFECYCLE_LIMITED_TX_ALLOWLIST=

# Gateway mempool fee-bump policy (checkpoint #743)
CONXIAN_BTC_FEE_BUMP_MAX_ATTEMPTS=3
CONXIAN_BTC_FEE_BUMP_MAX_FEE_RATE_SATS_VB=150
CONXIAN_BTC_FEE_BUMP_MIN_INCREMENT_SATS_VB=2
CONXIAN_BTC_FEE_BUMP_STUCK_THRESHOLD_BLOCKS=3
CONXIAN_BTC_FEE_BUMP_STUCK_THRESHOLD_SECONDS=900

# Legacy alias (typo) from older setups; prefer ENABLE_ISO20022_PACS008
# ENABLE_ISO2022_PACS008=true
ENABLE_REVENUE_INTELLIGENCE=true

# ============================================================================
# M2M (Machine-to-Machine) Authentication
# ============================================================================

# Admin Dashboard API Key (primary auth)
ADMIN_DASHBOARD_API_KEY=your-admin-api-key-here

# Service Keys for internal service-to-service auth
# Format: X-Service-Key: <service-id>:<key>
SERVICE_KEY_GATEWAY=your-gateway-service-key
SERVICE_KEY_ELIZAOS=your-elizaos-service-key
SERVICE_KEY_NEXUS=your-nexus-service-key
SERVICE_KEY_ORBIT=your-orbit-service-key
SERVICE_KEY_WALLET=your-wallet-service-key
SERVICE_KEY_UI=your-ui-service-key
SERVICE_KEY_ADMIN_DASHBOARD=your-admin-dashboard-service-key
SERVICE_KEY_PULSE_BOS=your-pulse-bos-service-key

# External API Keys (JSON format: {"key": ["scope1", "scope2"]})
EXTERNAL_API_KEYS={}

# Server-only JWT settings for token-based M2M auth.
# Use a secret with at least 32 bytes; never commit or expose it to browsers.
# GATEWAY_JWT_SECRET=replace-with-a-secret-managed-outside-git
# GATEWAY_JWT_ISSUER=https://issuer.example.internal
# GATEWAY_JWT_AUDIENCE=conxian-gateway
# Bounded policy: TTL 60..900 seconds, clock skew 0..60 seconds.
M2M_JWT_TTL_SECONDS=300
M2M_JWT_CLOCK_SKEW_SECONDS=30
# legacy is the safe default while the Rust Gateway verifier is coordinated.
M2M_GATEWAY_AUTH_MODE=legacy
