# Admin Dashboard - Institutional Secrets (Local Development Template)
# Copy this to .env.admin and fill in the values.
# This file is for local development persistence only.

# GitHub Personal Access Token (for deployments)
ADMIN_PAT_TOKEN=your_github_pat_here

# pnpm Registry Token
ADMIN_PNPM_TOKEN=your_pnpm_token_here

# PyPI API Token
ADMIN_PYPI_API_TOKEN=your_pypi_token_here

# GCP Service Account Key (JSON string)
# Format: {"type": "service_account", "project_id": "...", ...}
ADMIN_GCP_SA_KEY_JSON='{}'

# Changelly Integration
ADMIN_CHANGELLY_API_ID=your_changelly_id_here
ADMIN_CHANGELLY_API_SEC=your_changelly_secret_here

# Support & Intake (Linear)
SUPPORT_IMAP_PWD=your_imap_password_here
SUPPORT_SMTP_PWD=your_smtp_password_here
SUPPORT_LINEAR_TOKEN=your_linear_token_here
