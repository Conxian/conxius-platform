# Secrets and local configuration are never build inputs.
.env*
**/.env*
**/*.pem
**/*.key

# Keep host and CI artifacts out of the build context.
.git
.github
node_modules
**/node_modules
.next
**/.next
dist
**/dist
build
**/build
coverage
**/coverage
test-results
**/test-results
playwright-report
**/playwright-report
*.log
