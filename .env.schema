# conxius-platform Environment Schema
# This file defines the required environment variables for the entire stack.
# Values are NOT to be stored here. Use 'make auth' to generate a local .env.
# This is the development template; production uses .env.production.schema.

# --- Global / Infrastructure ---
PROJECT_NAME=conxian
NODE_ENV=development
GCP_PROJECT_ID=
GCP_REGION=

# --- Gateway (Unified API & Auth) ---
GATEWAY_PORT=8080
GATEWAY_JWT_SECRET=
GATEWAY_ADMIN_API_KEY=
GATEWAY_CORS_ORIGIN=http://localhost:3000
# Bitcoin tx lifecycle orchestration gate (CON-716 / #741)
CONXIAN_BTC_TX_LIFECYCLE_ENABLED=false
# When true (and feature enabled), transitions run in telemetry-only shadow mode.
CONXIAN_BTC_TX_LIFECYCLE_SHADOW_MODE=false

# --- Core Rust Engine ---
CORE_RPC_PORT=50051
CORE_DB_URI=
# Sandbox/harness network values: testnet | signet | regtest.
# Default behavior remains testnet when CORE_BITCOIN_NETWORK is unset.
CORE_BITCOIN_NETWORK=testnet

# --- Frontend (UI & Admin) ---
UI_PORT=3000
ADMIN_PORT=3001
ADMIN_DASHBOARD_API_KEY=
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080

# --- Sovereign Node Services ---
BISQ_RPC_HOST=bisq-node
BISQ_RPC_PORT=9999
RGB_RPC_HOST=rgb-node
RGB_RPC_PORT=9999
BITVM_RPC_HOST=bitvm-node
BITVM_RPC_PORT=9999

# --- Databases ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=conxian_db
REDIS_URL=redis://redis:6379

# --- Monitoring ---
GRAFANA_PASSWORD=

# --- CI/CD & GCP Service Accounts ---
# Used by platform/CI. Admin Dashboard stores its own GCP credentials in services/admin-dashboard/.env.admin as ADMIN_GCP_SA_KEY_JSON
# (and can optionally emit legacy aliases GCP_SA_KEY_JSON / GCP_CREDENTIALS).
GCP_SA_KEY_JSON=
GITHUB_RUNNER_TOKEN=

# --- Admin Dashboard secrets (service-scoped) ---
# Intentionally NOT part of root .env provisioning to avoid accidentally placing
# long-lived institutional tokens in the platform-wide .env or CI.
#
# Admin dashboard secrets are persisted in: services/admin-dashboard/.env.admin
# Template: services/admin-dashboard/.env.admin.example
