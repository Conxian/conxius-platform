# Conxius Institutional Secrets Template
# COPY THIS FILE TO .env.admin AND FILL IN THE ACTUAL VALUES
# NEVER COMMIT .env.admin TO GIT

# GitHub Personal Access Token (for automated repository management)
PAT_TOKEN=your_github_pat_token

# NPM Automation Token (for library publishing)
NPM_TOKEN=your_npm_token

# PyPI API Token (for Python library publishing)
PYPI_API_TOKEN=your_pypi_token

# GCP Service Account Credentials (JSON string)
# Note: keep this as a single line. If your key contains newlines, replace them with \n.
# Example (escaped JSON; dotenv-safe):
# GCP_CREDENTIALS="{\"type\":\"service_account\",\"project_id\":\"YOUR_PROJECT_ID\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\nREDACTED\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"YOUR_SA_EMAIL\"}"
GCP_CREDENTIALS="your_gcp_service_account_json"

# Changelly Institutional Exchange API
CHANGELLY_API_KEY=your_changelly_key
CHANGELLY_API_SECRET=your_changelly_secret
