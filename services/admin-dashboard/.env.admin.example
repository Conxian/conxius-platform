# Conxius Institutional Secrets Template
# COPY THIS FILE TO .env.admin AND FILL IN THE ACTUAL VALUES
# NEVER COMMIT .env.admin TO GIT

# GitHub Personal Access Token (for automated repository management)
ADMIN_PAT_TOKEN="your_github_pat_token"

# NPM Automation Token (for library publishing)
ADMIN_NPM_TOKEN="your_npm_token"

# PyPI API Token (for Python library publishing)
ADMIN_PYPI_API_TOKEN="your_pypi_token"

# GCP Service Account Credentials (JSON string)
# If you edit this file directly (without the Admin Dashboard), keep this as a single line and replace newlines with \n (valid JSON).
# If you use the Admin Dashboard UI, you can paste raw JSON (including newlines); it will be normalized when writing .env.admin.
# Example (escaped JSON; dotenv-safe):
# ADMIN_GCP_SA_KEY_JSON='{"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SA_EMAIL"}'
# Required: set this to your GCP service account JSON (single-line; keep \n escapes).
ADMIN_GCP_SA_KEY_JSON=''

# Changelly Institutional Exchange API
ADMIN_CHANGELLY_API_KEY="your_changelly_key"
ADMIN_CHANGELLY_API_SECRET="your_changelly_secret"
